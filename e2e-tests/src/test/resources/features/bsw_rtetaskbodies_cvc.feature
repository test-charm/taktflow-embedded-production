      {
        "phases": [
          { "op": "cadence", "targets": ["Vehicle_State"] }
        ]
      }
      """
      那么response should be:
      """
      body.json.results[0].state: {
        found: true
        busUp: true
        ecu: "cvc"
        cycleMs: 10
        cycleOk: true
        crcValid: true
