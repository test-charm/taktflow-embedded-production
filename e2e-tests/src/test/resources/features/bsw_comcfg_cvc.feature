      {
        "phases": [
          { "op": "txpdu", "id": 0 }
        ]
      }
      """
      那么response should be:
      """
      body.json.results[0].state: {
        found: true
        dlc: 4
        cycleMs: 10
        mode: "PERIODIC"
        e2e: true
        dataId: 1
        counterBit: 4
        crcBit: 8
      }
      """

